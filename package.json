{
  "name": "ntrr-hub",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "dev:turbo": "next dev --turbopack",
    "lan:sync": "node scripts/sync-lan-config.mjs",
    "lan:restore": "node scripts/sync-lan-config.mjs --restore",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "npx supabase start",
    "db:restart": "npx supabase stop && npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase status",
    "db:types": "npx supabase gen types typescript --local > lib/supabase/database.types.ts",
    "digest:run": "curl -s -X POST http://localhost:3000/api/cron/digest -H \"Authorization: Bearer ${SYNC_CRON_SECRET:-}\" | jq .",
    "test:unit": "npx tsx --test lib/dashboard/needs-attention.test.ts lib/calendar/visibility.test.ts lib/tasks/recurrence.test.ts lib/households/member-label.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/smoke.spec.ts --grep-invert 'Authenticated'"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "supabase": "^2.26.9",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3"
  }
}